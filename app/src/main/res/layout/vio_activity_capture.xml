<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/vio_preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vio_capture_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/vio_top_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#88000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_vio_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vio_state_idle"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_vio_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vio_offset_default"
            android:textColor="#FFD700"
            android:textSize="12sp"/>
    </LinearLayout>

    <com.example.visionproject.vio.ui.ReadinessBarView
        android:id="@+id/vio_readiness_bar"
        android:layout_width="64dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/vio_top_overlay"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp"/>

    <LinearLayout
        android:id="@+id/vio_capture_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#88000000"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_vio_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_start"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btn_vio_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_pause"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btn_vio_capture_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_capture_pair"
            android:textSize="11sp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btn_vio_process"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_process"
            android:textSize="11sp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btn_vio_imu_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_imu_test_short"
            android:textSize="11sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
