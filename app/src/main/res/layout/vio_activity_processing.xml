<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <TextView
        android:id="@+id/tv_vio_proc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vio_status_ready"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:padding="8dp"
        android:background="#22FFFFFF"/>

    <TextView
        android:id="@+id/tv_vio_median_z"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vio_median_z_default"
        android:textColor="#FFD700"
        android:textSize="13sp"
        android:padding="4dp"/>

    <com.example.visionproject.vio.ui.DisparityClickView
        android:id="@+id/vio_disparity_click_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn_vio_run_pipeline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_run"
            android:textSize="12sp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn_vio_compare_z"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_compare_z"
            android:textSize="12sp"
            android:enabled="false"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn_vio_export_ply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vio_btn_export_ply"
            android:textSize="12sp"
            android:enabled="false"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

</LinearLayout>
