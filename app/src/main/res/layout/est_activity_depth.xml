<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_depth_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mapa de Profundidade"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_depth_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toque no mapa para medir a distância (Z)"
        android:textColor="@android:color/holo_blue_dark"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000">

        <ImageView
            android:id="@+id/iv_disparity_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_compare_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📏 Comparar com fita"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_export_ply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar .PLY"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_finish_estereo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finalizar" />
    </LinearLayout>
</LinearLayout>
