<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionProject"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".modelocamera.ModeloCameraActivity"
            android:exported="false"
            android:label="@string/title_modelo_camera"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".calibracao.CalibrationActivity"
            android:exported="false"
            android:label="@string/btn_calibracao"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />

        <!-- Módulo 4: Visão Estéreo -->
        <activity
            android:name=".estereo.EstereoMainActivity"
            android:exported="false"
            android:label="@string/est_title_main"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".estereo.CaptureActivity"
            android:exported="false"
            android:label="@string/est_title_capture"
            android:parentActivityName=".estereo.EstereoMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".estereo.ProcessingActivity"
            android:exported="false"
            android:label="@string/est_title_processing"
            android:parentActivityName=".estereo.EstereoMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".estereo.DepthActivity"
            android:exported="false"
            android:label="@string/est_title_depth"
            android:parentActivityName=".estereo.EstereoMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />

        <!-- Módulo 5: VIO (Estéreo sem suporte) -->
        <activity
            android:name=".vio.VioMainActivity"
            android:exported="false"
            android:label="@string/vio_title_main"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".vio.VioCaptureActivity"
            android:exported="false"
            android:label="@string/vio_title_capture"
            android:parentActivityName=".vio.VioMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".vio.VioProcessingActivity"
            android:exported="false"
            android:label="@string/vio_title_processing"
            android:parentActivityName=".vio.VioMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
        <activity
            android:name=".vio.VioImuTestActivity"
            android:exported="false"
            android:label="@string/vio_title_imu_test"
            android:parentActivityName=".vio.VioMainActivity"
            android:theme="@style/Theme.VisionProject.NoWindowBackground" />
    </application>

</manifest>